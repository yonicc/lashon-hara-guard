// Runtime data must be bundled: Workers cannot read the repository filesystem.
import { readFileSync, readdirSync, writeFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
const root = new URL('../', import.meta.url);
const read = (p: string) => JSON.parse(readFileSync(new URL(p, root), 'utf8').replace(/^\uFEFF/, ''));
const cards = new Map<string, any>();
for (const file of readdirSync(new URL('rules/chafetz-chaim/cards/', root))) {
  if (file.endsWith('.json')) for (const c of read('rules/chafetz-chaim/cards/' + file)) cards.set(c.id, c);
}
const sections = read('engine/src/chafetzChaim/sourceCoverage.json').sections
  .filter((s: any) => s.disposition === 'blocked' || s.chatFeasibility === 'external_evidence');
const selected = sections.map((s: any) => {
  const c = cards.get(s.cardId);
  if (!c) throw new Error('Missing referral card: ' + s.cardId);
  const { key, disposition, blocker, ref, url, cardId, implementedScopeHe, unimplementedHe, chatFeasibility, ruleIds } = s;
  return { key, disposition, blocker, ref, url, cardId, implementedScopeHe, unimplementedHe, chatFeasibility, ruleIds,
    card: { summaryHe: c.summaryHe, quotesHe: c.quotesHe, uncertainHe: c.uncertainHe, factsNeeded: c.factsNeeded } };
});
if (selected.length !== 73) throw new Error('Review group-D classification before regeneration');
const output = '// Generated by scripts/generate-referral-data.mts; do not edit.\n' +
  'export const REFERRAL_DATA = ' + JSON.stringify(selected, null, 2) + ';\n';
const target = new URL('engine/src/chafetzChaim/referralData.ts', root);
if (process.argv.includes('--check')) {
  if (readFileSync(target, 'utf8').replace(/\r\n/g, '\n') !== output) throw new Error('Referral data is stale');
} else writeFileSync(target, output);
console.log('Referral data: ' + selected.length + ' sections; ' + fileURLToPath(target));
