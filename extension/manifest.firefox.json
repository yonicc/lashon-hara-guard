{
  "manifest_version": 3,
  "name": "Lashon Hara Guard (MVP)",
  "version": "0.17.9",
  "description": "תזכורת עדינה בזמן כתיבה וליד הודעות נכנסות כשהודעה עלולה להתפרש כגנאי. אינה פסיקה הלכתית.",
  "permissions": ["storage", "tabs"],
  "optional_host_permissions": ["https://lhg-proxy.yonicc.workers.dev/*", "https://huggingface.co/*", "https://*.hf.co/*", "http://127.0.0.1:11434/*"],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"},
  "background": {"scripts": ["settings.js", "rules.js", "i18n.js", "billing.js", "check-mode.js", "ollama-client.js", "ollama-engine.bundle.js", "ollama-register.js", "ollama-setup.js", "memory-background.js", "context-loop.js", "background.js"]},
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "פתח/סגור את פאנל Lashon Hara Guard בעמוד הנתמך שבפוקוס"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["early-incoming.js"],
      "css": ["early-incoming.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["i18n.js", "settings.js", "billing.js", "context-dom.js", "context-store.js", "context-builder.js", "context-runtime.js", "selectors.js", "memory-content.js", "rules.js", "referral-topics.js", "panel.js", "compose-watch.js", "incoming.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["i18n.js", "settings.js", "billing.js", "context-dom.js", "context-store.js", "context-builder.js", "context-runtime.js", "selectors.js", "memory-content.js", "rules.js", "referral-topics.js", "panel.js", "compose-watch.js", "incoming.js", "content-google.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "action": {"default_title": "Lashon Hara Guard", "default_popup": "popup.html"},
  "browser_specific_settings": {"gecko": {"id": "lhg@ysho.uk", "strict_min_version": "140.0", "data_collection_permissions": {"required": ["personalCommunications", "authenticationInfo", "websiteContent"]}}}
}
