{
  "manifest_version": 3,
  "name": "Lashon Hara Guard (MVP)",
  "version": "0.2.0",
  "description": "תזכורת עדינה בזמן כתיבה וליד הודעות נכנסות כשהודעה עלולה להתפרש כגנאי. אינה פסיקה הלכתית.",
  "permissions": ["storage"],
  "host_permissions": ["https://lhg-proxy.yonicc.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["selectors.js", "incoming.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["selectors.js", "incoming.js", "content-google.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Lashon Hara Guard", "default_popup": "options.html" }
}
