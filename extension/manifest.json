{
  "manifest_version": 3,
  "name": "Lashon Hara Guard (MVP)",
  "version": "0.15.0",
  "description": "תזכורת עדינה בזמן כתיבה וליד הודעות נכנסות כשהודעה עלולה להתפרש כגנאי. אינה פסיקה הלכתית.",
  "permissions": ["storage", "tabs", "offscreen"],
  "minimum_chrome_version": "116",
  "content_security_policy": {"extension_pages":"script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"},
  "host_permissions": ["https://lhg-proxy.yonicc.workers.dev/*", "https://huggingface.co/*", "https://*.hf.co/*", "http://127.0.0.1:11434/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "פתח/סגור את פאנל Lashon Hara Guard בעמוד הנתמך שבפוקוס"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["early-incoming.js"],
      "css": ["early-incoming.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["i18n.js", "settings.js", "context-dom.js", "context-store.js", "context-builder.js", "context-runtime.js", "selectors.js", "memory-content.js", "rules.js", "panel.js", "compose-watch.js", "incoming.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["i18n.js", "settings.js", "context-dom.js", "context-store.js", "context-builder.js", "context-runtime.js", "selectors.js", "memory-content.js", "rules.js", "panel.js", "compose-watch.js", "incoming.js", "content-google.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Lashon Hara Guard", "default_popup": "popup.html" }
}
