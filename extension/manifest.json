{
  "manifest_version": 3,
  "name": "Lashon Hara Guard (MVP)",
  "version": "0.7.1",
  "description": "תזכורת עדינה בזמן כתיבה וליד הודעות נכנסות כשהודעה עלולה להתפרש כגנאי. אינה פסיקה הלכתית.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://lhg-proxy.yonicc.workers.dev/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "פתח/סגור את פאנל Lashon Hara Guard בעמוד הנתמך שבפוקוס"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["context-dom.js", "context-store.js", "context-builder.js", "context-runtime.js", "selectors.js", "panel.js", "compose-watch.js", "incoming.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.google.com/*", "https://mail.google.com/*"],
      "js": ["context-dom.js", "context-store.js", "context-builder.js", "context-runtime.js", "selectors.js", "panel.js", "compose-watch.js", "incoming.js", "content-google.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Lashon Hara Guard", "default_popup": "options.html" }
}
